import pandas as pd
import numpy as np
import joblib
from sklearn.preprocessing import MinMaxScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense

# 1. Data Ingestion
df = pd.read_csv('avg-system-cpu-user-project-predictive-hpa-thesis.csv')
data = df['value'].values.reshape(-1, 1)

# 2. Data Normalization
# Scaling telemetry metrics to [0, 1] range to ensure stable LSTM convergence
scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(data)

# 3. Sliding Window Sequence Generation
# Transforming time-series data into supervised learning format 
# using a window size of 10 observations to predict the 11th step
X, y = [], []
for i in range(10, len(scaled_data)):
    X.append(scaled_data[i-10:i, 0])
    y.append(scaled_data[i, 0])
X, y = np.array(X), np.array(y)
X = np.reshape(X, (X.shape[0], X.shape[1], 1))

# 4. LSTM Model Architecture
# Sequential model with a 64-unit LSTM layer for long-term temporal feature extraction
model = Sequential([
    LSTM(64, return_sequences=False, input_shape=(10, 1)),
    Dense(1)
])
model.compile(optimizer='adam', loss='mse')
model.fit(X, y, epochs=100, batch_size=16)

# 5. Model Serialization
# Exporting trained weights and the scaler object for real-time inference
model.save('predictive_model.h5')
joblib.dump(scaler, 'scaler.pkl')
